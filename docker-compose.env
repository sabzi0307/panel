ADMIN_EMAIL=borikhaan@gmail.com
ADMIN_PASSWORD=Betocheh@n
key=ChangeMe # Cookie encryption key, please be sure to modify this key to a random string
# pwdMethod=bcrypt # Password encryption optional md5, sha256, bcrypt, argon2i, argon2id
# salt=# Recommended for md5/sha256， bcrypt/argon2i/argon2id will ignore this
debug=false # debug mode switch，The production environment should be kept as false
appName=IRPanel # Site name
baseUrl=https://we-connect.live # site address
muKey=SSPANEL # WebAPI Key, used for communication between the node server and the panel，Be sure to modify this key to a random string
# --database settings--------------------------------------------------------------------------------------------
# db_host|db_socket Choose one of the two, if set db_socket then db_host Will be ignored, please leave blank. If the database is on the local machine it is recommended to use db_socket。
# db_host example: localhost (resolvable hostname), 127.0.0.1（IP address）, 10.0.0.2:4406（With port)
# db_socket example：/var/run/mysqld/mysqld.sock（Absolute address is required）
db_host=ss_db # database host
db_port=3306 # database port
MYSQL_ROOT_PASSWORD=sspanel
MYSQL_DATABASE=sspanel # Database name
MYSQL_USER=sspanel # database username
MYSQL_PASSWORD=sspanel # The password corresponding to the username
# --Advanced
# db_charset=utf8mb4
# db_collation=utf8mb4_unicode_ci
# db_prefix=
# --E-Mail settings--------------------------------------------------------------------------------------------
# mail_filter=0 # 0: off; 1: whitelist mode; 2; blacklist mode;
# mail_filter_list=qq.com, vip.qq.com, foxmail.com
# --Registered user settings---------------------------------------------------------------------------------------
# --Base
# enable_checkin=true # enable the sign-in function
# checkinMin=1 # User sign-in minimum traffic unit MB
# checkinMax=50 # User check-in traffic with the most traffic
# auto_clean_uncheck_days=-1 # Automatically clean up level 0 users who have not signed in for how many days, and close when less than or equal to 0
# auto_clean_unused_days=-1 # How many days of unused level 0 users will be automatically cleared, and it will be turned off when it is less than or equal to 0
# auto_clean_min_money=1 # Level 0 users whose balance is lower than a certain amount can be cleared
# --Advanced
# class_expire_reset_traffic=0 # The traffic value to reset to when the level expires, in GB, if it is less than 0, it will not be reset
# account_expire_delete_days=-1 # The account will be deleted a few days after the account expires, and it will not be deleted when it is less than 0
# enable_kill=true # allow users to log out of accounts
# enable_change_email=true # allow users to change account email
# --Email reminder for insufficient user data allowance
# notify_limit_mode=false # false is closed, per is reminded according to percentage, mb is reminded according to fixed remaining traffic
# notify_limit_value=20 # When the previous item is per, fill in the percentage here; when the previous item is mb, fill in the traffic here
# --log settings---------------------------------------------------------------------------------------
# trafficLog=false # record the traffic used by users every hour
# trafficLog_keep_days=7 # Number of days to keep usage traffic records per hour
# subscribeLog=false # record user subscription logs
# subscribeLog_keep_days=7 # Number of days to keep subscription records
# --Audit auto-ban settings--------------------------------------------------------------------------------------------
# Subscribe=true # Does this site provide a subscription function?
# subUrl=# Subscription address, if it needs to be the same as the site name, please do not modify
# --Audit auto-ban settings--------------------------------------------------------------------------------------------
# enable_auto_detect_ban=false # Audit Auto-Ban Switch
# auto_detect_ban_numProcess=300 # The number of audit records processed in a single scheduled task
# auto_detect_ban_allow_admin=true # Administrators are not subject to audit restrictions
# auto_detect_ban_allow_users= # Exception User IDs for Audit Bans
# --Judgment type of audit ban：
#   --- 1 =Benevolent mode, every touch how many times to ban
#   --- 2 = Crazy mode, the cumulative number of touches will be banned for different lengths of time according to the ladder
# auto_detect_ban_type=1
# auto_detect_ban_number=30 # The number of procs needed to enforce a ban in mercy mode
# auto_detect_ban_time=60 # The duration of each ban in mercy mode (minutes)
# --Bot set up--------------------------------------------------------------------------------------------
# --Telegram bot
enable_telegram=false # enable Telegram bot
# telegram_token=# Telegram bot token ，with father bot Application
# telegram_chatid=# Telegram bot,Group session ID, follow the robot after pulling it into the group /ping get it in one click
# telegram_bot=_bot # Telegram bot account
# telegram_request_token= # Webhook key, after updating this parameter please php xcat Tool setTelegram, Telegram The robot requests Key, which can be set at will, consisting of uppercase and lowercase English and numbers. After updating this parameter, please php xcat Tool setTelegram
# --node detection-----------------------------------------------------------------------------------------------
# --GFW detection, please [enable/disable] through crontab
# detect_gfw_interval=3600 # Detection interval, unit: second, if it is lower than the recommended value, it will explode
# detect_gfw_port=443 # The TCP port opened by all node servers, commonly used is 22 (SSH port)
# detect_gfw_url=http://example.com:8080/tcping?ip={ip}&port={port} # The URL of the API that detects whether the node is blocked by gfw
# detect_gfw_count=3 # number of attempts
# enable_detect_offline=true # offline detection
# --All of the following are advanced settings (generally not used, do not need to change---------------------------------------------------------------------
# --Does the master site provide WebAPI
# --- For security, it is recommended to use the WebAPI mode to connect to the node and close the public network database connection.
# --- Can be set to false if all your nodes use database connections or if you have a separate WebAPI site or gRPC API.
# WebAPI=true
# --Misc
# authDriver=cookie # optional: cookies
# sessionDriver=cookie # optional: cookies
# cacheDriver=cookie # optional: cookies
# tokenDriver=db # optional: db
# enable_login_bind_ip=false # bind the login thread to the IP
# rememberMeDuration=7 # Remember the number of days of account duration when logging in
# timeZone=Asia/Tehran # Requires a PHP-compatible timezone format
# theme=tabler # Default Theme
# jump_delay=1200 # Jump delay, in ms, it is not recommended to be too long
# checkNodeIp=true # webapi verifies node ip
# keep_connect=false # Speed limit to 1Mbps for traffic exhausted users
# --Cloudflare
# cloudflare_enable=false # enable Cloudflare analysis
# cloudflare_email= # Cloudflare email address
# cloudflare_key= # Cloudflare API Key
# cloudflare_name= # domain name
# --include statistical codes, create an analytics.tpl under resources/views/{theme name}, and use literal delimiters if necessary
# enable_analytics_code=false
# sentry_dsn= # https://sentry.io for production debugging
# --Maxmind GeoIP2 database
# maxmind_license_key=local
# geoip_locale=en
# --OpenAI API Key for GPT powered ticket reply and more
# openai_api_key:
# ai_model=gpt-3.5-turbo
# --ClientDownload command resolves the restricted use of Github access tokens due to the high frequency of API access
# GIT_PERSONAL_TOKEN:
php_user_group="nginx:nginx"
# Backup settings--------------------------------------------------------------------------------------------
B2_BACKUP=false
# B2_APP_KEY_ID= 
# B2_APP_KEY= 
# B2_BUCKET_NAME=sspanel
# B2_BACKUP_NAME=SSPANEL
# B2_COMPRESS_METHOD=zip
# --Container Settings --------------------------------------------------------------------------------------
# --The following flags are a list of all the currently supported options that can be changed by passing in the variables to docker win env.
# --Git
GIT_REPO=github.com/kontorol/Panel # URL to the repository containing your source code. If you are using a personal token, this is the https URL without https:// (e.g github.com/project/). For ssh prepend with git@ (e.g git@github.com/project.git)
GIT_BRANCH=dev # Select a specific branch (optional)
# GIT_TAG= # Specify a specific git tag (optional)
# GIT_COMMIT= # Specify a specific git commit (optional)
GIT_EMAIL=kontorol.dev@gmail.com # Set your email for code pushing (required for git to work)
GIT_NAME=kontorol # Set your name for code pushing (required for git to work)
# GIT_USE_SSH= # Set this to 1 if you want to use git over SSH (instead of HTTP), useful if you want to use Bitbucket instead of GitHub
# SSH_KEY= # Private SSH deploy key for your repository base64 encoded (requires write permissions for pushing)
GIT_PERSONAL_TOKEN=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 # Personal access token for your git account (required for HTTPS git access)
GIT_USERNAME=kontorol # Git username for use with personal tokens. (required for HTTPS git access)
# --Others
# OPcache= # Set to 1 to disable opcache (enabled by default)
WEBROOT=/var/www/html # Change the default webroot directory from /var/www/html to your own setting
ERRORS=1 # Set to 1 to display PHP Errors in the browser
# HIDE_NGINX_HEADERS= # Disable by setting to 0, default behaviour is to hide nginx + php version in headers
PHP_CATCHALL=1 # Enable a 404 catch all to index.php -- changes =404 on try_files to /index.php?$args
# PHP_MEM_LIMIT= # Set higher PHP memory limit, default is 128 Mb
# PHP_POST_MAX_SIZE= # Set a larger post_max_size, default is 100 Mb
# PHP_UPLOAD_MAX_FILESIZE= # Set a larger upload_max_filesize, default is 100 Mb
PHP_ERRORS_STDERR=1 # Send php logs to docker logs
DOMAIN=we-connect.live # Set domain name for Lets Encrypt scripts
REAL_IP_HEADER=1 # set to 1 to enable real ip support in the logs
# REAL_IP_FROM= # set to your CIDR block for real ip in logs
RUN_SCRIPTS=1 # Set to 1 to execute scripts
# SCRIPTS_DIR= # Change default scripts dir from /var/www/html/scripts to your own setting
# PGID= # Set to GroupId you want to use for nginx (helps permissions when using local volume)
# PUID= # Set to UserID you want to use for nginx (helps permissions when using local volume)
# REMOVE_FILES= # Use REMOVE_FILES=0 to prevent the script from clearing out /var/www/html (useful for working with local files)
# APPLICATION_ENV= # Set this to development to prevent composer deleting local development dependencies
# SKIP_CHOWN= # Set to 1 to avoid running chown -Rf on /var/www/html
# SKIP_CHMOD= # Set to 1 to avoid running chmod -Rf 750 on SCRIPTS_DIR
# SKIP_COMPOSER= # Set to 1 to avoid installing composer
